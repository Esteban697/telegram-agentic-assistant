# Copia este fichero a `.env` y rellena los valores.
# NUNCA escribas secretos reales en un fichero versionado: `.env` está en .gitignore.
#
# Fase 1: solo se declaran las variables que la Fase 1 lee de verdad. El resto de
# la tabla de PLAN.md §8.1 (base de datos, embeddings, recordatorios, RAG) se
# añade en la fase que la consume, para no tener configuración muerta.

# --- Aplicación -------------------------------------------------------------
# development | test | production. En production se activan las validaciones
# de arranque (ver app/config.py).
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true solo para depurar contenido. Por defecto NO se registran mensajes,
# documentos, embeddings ni secretos.
LOG_CONTENT_DEBUG=false

# --- Telegram ---------------------------------------------------------------
# Token del bot creado con @BotFather.
TELEGRAM_BOT_TOKEN=
# Secreto del webhook (1-256 caracteres de A-Za-z0-9_-). Debe coincidir con el
# valor enviado a setWebhook; se valida en cada petición.
TELEGRAM_WEBHOOK_SECRET=
# Lista de IDs numéricos de Telegram autorizados, separados por comas.
# En production, si está vacía el servicio NO arranca (denegación por defecto).
TELEGRAM_ALLOWED_USER_IDS=
# Solo para pruebas locales: permite cualquier usuario. Prohibido en production.
DEV_ALLOW_ANY_USER=false
# Base de la Bot API. Cámbiala solo para apuntar a un transporte de pruebas.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Longitud máxima aceptada de un mensaje entrante (límite de Telegram: 4096).
MAX_MESSAGE_CHARS=4096
# Tamaño máximo del cuerpo del webhook antes de rechazarlo con 413.
MAX_WEBHOOK_BODY_BYTES=1048576

# --- LLM (Ollama) -----------------------------------------------------------
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# Modelo de chat. Se resuelve en tiempo de ejecución contra /api/tags: no se
# codifica ninguna variante concreta en el código.
LLM_MODEL=gpt-oss:120b-cloud
# Debe cumplir: LLM_TIMEOUT_SECONDS x (LLM_MAX_RETRIES + 1) + reintentos + margen
# <= REQUEST_BUDGET_SECONDS. Con estos valores: 18 x 2 + 0,25 + 2 = 38,25 s <= 45 s.
# Si no se cumple, el arranque falla indicando la aritmética: significaría que el
# timeout del modelo nunca puede dispararse y que LLM_MAX_RETRIES no sirve de nada.
LLM_TIMEOUT_SECONDS=18
LLM_MAX_RETRIES=1
# off | low | medium | high (vacío = no enviar el parámetro)
LLM_THINK=low

# --- Presupuesto y límites --------------------------------------------------
# Presupuesto de tiempo de una petición de Telegram. En Fase 1 se aplica como
# timeout duro alrededor del grafo (PLAN.md §10 Phase 1, NN8). Debe quedar por
# debajo del plazo de 60 s que impone Telegram al webhook.
REQUEST_BUDGET_SECONDS=45
# Límite de peticiones por usuario y ventana, por instancia.
RATE_LIMIT_PER_MINUTE=20

# --- Almacenes (Fase 1: en memoria) -----------------------------------------
# memory | postgres. `memory` es un error de arranque en production.
STORE_BACKEND=memory
CONTEXT_MAX_MESSAGES=20
CONTEXT_TTL_SECONDS=3600
UPDATE_DEDUPE_TTL_SECONDS=3600
UPDATE_DEDUPE_MAX_ENTRIES=10000
