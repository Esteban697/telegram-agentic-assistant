# Copia este fichero a `.env` y rellena los valores.
# NUNCA escribas secretos reales en un fichero versionado: `.env` está en .gitignore.
#
# Fase 1: solo se declaran las variables que la Fase 1 lee de verdad. El resto de
# la tabla de PLAN.md §8.1 (base de datos, embeddings, recordatorios, RAG) se
# añade en la fase que la consume, para no tener configuración muerta.

# --- Aplicación -------------------------------------------------------------
# development | test | production. En production se activan las validaciones
# de arranque (ver app/config.py).
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true solo para depurar contenido. Por defecto NO se registran mensajes,
# documentos, embeddings ni secretos.
LOG_CONTENT_DEBUG=false

# --- Telegram ---------------------------------------------------------------
# Token del bot creado con @BotFather.
TELEGRAM_BOT_TOKEN=
# Secreto del webhook (1-256 caracteres de A-Za-z0-9_-). Debe coincidir con el
# valor enviado a setWebhook; se valida en cada petición.
TELEGRAM_WEBHOOK_SECRET=
# Lista de IDs numéricos de Telegram autorizados, separados por comas.
# En production, si está vacía el servicio NO arranca (denegación por defecto).
TELEGRAM_ALLOWED_USER_IDS=
# Solo para pruebas locales: permite cualquier usuario. Prohibido en production.
DEV_ALLOW_ANY_USER=false
# Base de la Bot API. Cámbiala solo para apuntar a un transporte de pruebas.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Longitud máxima aceptada de un mensaje entrante (límite de Telegram: 4096).
MAX_MESSAGE_CHARS=4096
# Tamaño máximo del cuerpo del webhook antes de rechazarlo con 413.
MAX_WEBHOOK_BODY_BYTES=1048576

# --- LLM (Ollama) -----------------------------------------------------------
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
# Modelo de chat. Se resuelve en tiempo de ejecución contra /api/tags: no se
# codifica ninguna variante concreta en el código.
LLM_MODEL=gpt-oss:120b-cloud
# Debe cumplir: LLM_TIMEOUT_SECONDS x (LLM_MAX_RETRIES + 1) + reintentos + margen
# <= REQUEST_BUDGET_SECONDS. Con estos valores: 18 x 2 + 0,25 + 2 = 38,25 s <= 45 s.
# Si no se cumple, el arranque falla indicando la aritmética: significaría que el
# timeout del modelo nunca puede dispararse y que LLM_MAX_RETRIES no sirve de nada.
LLM_TIMEOUT_SECONDS=18
LLM_MAX_RETRIES=1
# off | low | medium | high (vacío = no enviar el parámetro)
LLM_THINK=low
# Modelo multimodal de Ollama Cloud para turnos con imagen. No se usa un Ollama local.
VISION_MODEL=gemma4:31b
# Tope de la imagen descargada de Telegram y timeout de la inferencia visual.
MAX_IMAGE_MB=10
VISION_TIMEOUT_SECONDS=30

# --- Informe de gastos (opcional) -------------------------------------------
# Exportación de facturación a BigQuery. El toggle de exportación se activa una vez
# en la consola de Billing (no hay API para eso). Vacío = GOOGLE_CLOUD_PROJECT.
BILLING_EXPORT_PROJECT=
BILLING_EXPORT_DATASET=billing_export
# Vacío = autodetecta gcp_billing_export_resource_v1_* o gcp_billing_export_v1_*.
BILLING_EXPORT_TABLE=
# Días que cubre la consulta del informe (incluye el mes en curso).
BILLING_REPORT_DAYS=32

# --- Resumen de la mañana --------------------------------------------------- #
# Job diario a las 07:30 (Europe/Madrid): agenda del día, recordatorios pendientes, tiempo y
# gasto de ayer. Cada sección degrada por su cuenta: si el calendario o el tiempo fallan, el
# resumen llega igual. Open-Meteo no necesita clave, así que esto no añade ningún secreto.
MORNING_BRIEF_ENABLED=false
# Coordenadas del lugar cuyo tiempo se muestra (por defecto, Madrid).
MORNING_BRIEF_LATITUDE=40.4168
MORNING_BRIEF_LONGITUDE=-3.7038
MORNING_BRIEF_CITY=Madrid
MORNING_BRIEF_TIMEOUT_SECONDS=10

# --- Búsqueda web (Ollama Cloud) ---------------------------------------------
# ollama | none. Con `ollama` la herramienta `search_web` llama a
# POST https://ollama.com/api/web_search con la misma OLLAMA_API_KEY del chat; cada
# consulta cuenta en la cuenta de Ollama. `none` deja la herramienta respondiendo
# CapabilityUnavailable.
WEB_SEARCH_PROVIDER=ollama
WEB_SEARCH_BASE_URL=https://ollama.com
# La API admite de 1 a 10 resultados (por defecto 5).
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10
# Recorte por resultado y total: los pasajes pueden traer miles de tokens y no
# deben consumir el contexto ni el presupuesto del turno.
WEB_SEARCH_MAX_CONTENT_CHARS=2000
WEB_SEARCH_MAX_TOTAL_CHARS=8000

# --- Google Calendar (OAuth) -------------------------------------------------
# false = las herramientas de calendario no se registran. En producción se pone a
# true con el secreto GOOGLE_OAUTH_CREDENTIALS ya creado.
GOOGLE_CALENDAR_ENABLED=false
# Calendario sobre el que se lee y escribe. `primary` es el principal de la cuenta.
GOOGLE_CALENDAR_ID=primary
# JSON con client_id, client_secret, refresh_token, token_uri y scopes. Vacío en el
# repositorio; en producción se monta desde Secret Manager. Lo genera
# scripts/google_auth.py tras autorizar la cuenta una vez.
GOOGLE_OAUTH_CREDENTIALS=
GOOGLE_CALENDAR_TIMEOUT_SECONDS=10
# Tope de eventos por consulta y de días por rango; más que esto se rechaza.
GOOGLE_CALENDAR_MAX_RESULTS=50
GOOGLE_CALENDAR_MAX_RANGE_DAYS=90
# Tope de invitados por evento.
GOOGLE_CALENDAR_MAX_ATTENDEES=20
# Ventana de trabajo para calcular huecos libres (hora local).
GOOGLE_CALENDAR_WORKDAY_START_HOUR=9
GOOGLE_CALENDAR_WORKDAY_END_HOUR=18
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=60

# --- Presupuesto y límites --------------------------------------------------
# Presupuesto de tiempo de una petición de Telegram. En Fase 1 se aplica como
# timeout duro alrededor del grafo (PLAN.md §10 Phase 1, NN8). Debe quedar por
# debajo del plazo de 60 s que impone Telegram al webhook.
REQUEST_BUDGET_SECONDS=45
# Límite de peticiones por usuario y ventana, por instancia.
RATE_LIMIT_PER_MINUTE=20

# --- Almacenes (Fase 1: en memoria) -----------------------------------------
# memory | postgres. `memory` es un error de arranque en production.
STORE_BACKEND=memory
CONTEXT_MAX_MESSAGES=20
CONTEXT_TTL_SECONDS=3600
UPDATE_DEDUPE_TTL_SECONDS=3600
UPDATE_DEDUPE_MAX_ENTRIES=10000

# --- Base de datos (Fase 2) -------------------------------------------------
# DSN asíncrona que usa la aplicación (SQLAlchemy + psycopg 3 async).
DATABASE_URL=
# DSN síncrona que usan Alembic y los scripts: las migraciones no se ejecutan
# dentro del bucle de eventos.
DATABASE_SYNC_URL=
# Tamaño de cada pool. Deben cumplir:
#   (DB_POOL_SIZE + CHECKPOINTER_POOL_SIZE) x procesos <= max_connections - 5
DB_POOL_SIZE=4
CHECKPOINTER_POOL_SIZE=3
# Ejecutar las migraciones al arrancar. Prohibido en production: un cambio de
# esquema no debe ser un efecto secundario de arrancar un servicio.
MIGRATIONS_AUTORUN=false
# Zona horaria por defecto de los recordatorios (zona IANA).
DEFAULT_TIMEZONE=Europe/Madrid

# --- Recordatorios (Fase 2: lógica de reclamo; la programación llega en Fase 5)
REMINDER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=5
# Debe ser mayor que el tiempo máximo de ejecución del job de despacho, o la
# reconciliación puede marcar como `unknown` un envío que aún se está entregando.
DISPATCHER_LEASE_SECONDS=900
# telegram = envío real. record = escribe cada envío en NOTIFY_RECORD_PATH
# (solo para pruebas; prohibido en production).
NOTIFICATIONS_TRANSPORT=telegram
NOTIFY_RECORD_PATH=

# --- Aprobaciones (Fase 3) --------------------------------------------------
# Minutos que una aprobación sigue siendo válida. Al reclamarla se vuelve a
# comprobar, así que un botón antiguo no puede ejecutar nada más tarde.
APPROVAL_TTL_MINUTES=30
# Una fila `started` del registro de herramientas más antigua que esto queda
# como `unknown` en vez de reintentarse.
STALE_INVOCATION_SECONDS=900

# --- Documentos y RAG (Fase 4) ----------------------------------------------
# vertex | stub. `vertex` es el proveedor de la aplicación en todos los entornos
# (PLAN.md §13.1): un solo proveedor, un solo camino de código, 768 dimensiones.
# `stub` es el doble léxico que usan las pruebas sin credenciales, y es un error
# de arranque en production.
EMBED_PROVIDER=vertex
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_TIMEOUT_SECONDS=30
# Proyecto y región de Vertex AI. Requiere credenciales de aplicación:
#   gcloud auth application-default login
#   gcloud services enable aiplatform.googleapis.com
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=europe-west1
# Bucket privado para los originales. Vacío = almacén en memoria (solo desarrollo).
GCS_BUCKET=
MAX_PDF_PAGES=200
MAX_INGEST_SECONDS=120
# Techo del trabajo de ingesta dentro de la petición (el trabajo en segundo plano es de la
# Fase 5). El plazo efectivo es el menor entre este valor y una fracción del presupuesto de la
# petición, para que el webhook conteste dentro del plazo de Telegram.
INGEST_INLINE_BUDGET_SECONDS=30
# Cuántos documentos coge una ejecución del job de ingestas pendientes
# (`python -m app.jobs.process_documents`, Fase 5). El job no tiene presupuesto de petición: su
# límite es el timeout del propio Cloud Run Job, así que este número acota una pasada por trabajo
# y la siguiente ejecución programada recoge lo que quede.
DOCUMENT_JOB_BATCH_SIZE=10
# Segmentación: nunca cruza una página, para que cada cita apunte a una sola.
RAG_CHUNK_CHARS=1500
RAG_CHUNK_OVERLAP_CHARS=200
RAG_CHUNK_MAX_CHARS=4000
RAG_CHUNK_MIN_CHARS=200
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000
# Filtro de coincidencias degeneradas (similitud coseno), aplicado en el único punto de
# recuperación. **NO es un umbral de relevancia** y no lo trates como tal:
#   - con el stub léxico elimina los fragmentos que no comparten ninguna palabra de contenido con
#     la pregunta (puntúan 0.0000; la coincidencia legítima más débil del corpus de prueba puntúa
#     0.1931);
#   - con Vertex AI no elimina nada: medido con gemini-embedding-001, la página que responde
#     puntúa 0.7332 y una pregunta ajena 0.5425, así que **ningún umbral global separa** "no hay
#     evidencia" de "hay evidencia" (un umbral de 0.55 rechazaría también paráfrasis legítimas).
# Quién decide si hay evidencia es el prompt, que recibe de la búsqueda `found`, `evidence`,
# `best_score` y este valor. Cambiar este número no es la palanca para mejorar las respuestas.
RAG_MIN_SCORE=0.10

# Tamaño máximo de un documento subido (MB).
MAX_UPLOAD_MB=20
